# Onaar FastAPI Environment Variables

# Project & Environment
PROJECT_NAME="Onaar E-Commerce Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Local development uses SQLite by default. Set real PostgreSQL URL for production.
DATABASE_URL="sqlite+aiosqlite:///backend/onaar.db"
# Example PostgreSQL/Supabase:
# DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres"
SUPABASE_URL="https://btiuwbqbkltwlefcqhjd.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Dynamic SMTP Configuration (Nodemailer / aiosmtplib compatible)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="meriwebdunia@gmail.com"
SMTP_PASSWORD=""
SMTP_USE_TLS=true
SMTP_FROM_NAME="ONAAR / Pure Harvest"
SMTP_FROM_EMAIL="meriwebdunia@gmail.com"

# Vendor Destination
VENDOR_NAME="Anurag Jain"
VENDOR_EMAIL="meriwebdunia@gmail.com"
VENDOR_PHONE="+91-98765 43210"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://anurag-project.vercel.app"]

